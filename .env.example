# ─────────────────────────────────────────────────────────────────────────────
# AgentVault environment
#
# Every variable here is SERVER-SIDE ONLY. Nothing in this file may ever be
# prefixed NEXT_PUBLIC_ — that prefix inlines the value into the client bundle.
# Copy to .env.local and fill in. .env.local is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# SERV Reasoning (OpenAI-compatible inference API)
# Key from https://console.openserv.ai/settings/keys
SERV_API_KEY=

# Coinbase Developer Platform
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# Chain. Base Sepolia only — there is no mainnet path in this repo.
NETWORK_ID=base-sepolia

# Optional: custom RPC endpoint. Falls back to the chain default when empty.
RPC_URL=

# Optional: passed to CDP account creation for idempotency.
IDEMPOTENCY_KEY=

# The stable named CDP account. Changing this name points the agent at a
# DIFFERENT wallet — see lib/agentkit/wallet.ts.
AGENT_WALLET_NAME=agentvault-agent

# Required by `npm run spike:transfer`. No default on purpose: a wrong default
# would send real testnet funds somewhere unintended.
TEST_RECIPIENT_ADDRESS=

# Where POST /api/execute sends funds to enter a position.
# The seeded Milestone 1-3 opportunity is a testnet placeholder with no real
# lending pool behind it, so this is a stand-in destination. The transfer is a
# REAL on-chain transaction either way. Execution refuses when this is unset.
OPPORTUNITY_DEPOSIT_ADDRESS=

# Placeholders until Milestone 3.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Mirror audit events to stdout. "on" to enable.
AUDIT_STDOUT=on
